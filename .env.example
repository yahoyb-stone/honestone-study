# 값은 절대 채워서 커밋하지 마세요. 키 이름만 참고용으로 둡니다.

# 배포 주소 — OG 이미지·canonical·sitemap 의 기준이 됩니다.
# 도메인을 연결하기 전에는 비워 두어도 됩니다 (Vercel 배포 주소를 자동으로 씁니다).
NEXT_PUBLIC_SITE_URL=

# Supabase — 신청이 저장되는 곳.
# 어니스톤이 이미 쓰고 있는 프로젝트의 값을 그대로 넣으면, 신청 명단이
# 기존 관리자 화면에 함께 뜹니다. (RPC: submit_visitor_request)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 신규 신청 알림 메일 — Gmail SMTP.
# SMTP_PASS 는 계정 비밀번호가 아니라 '앱 비밀번호' 16자입니다.
# 비워 두면 메일 알림만 건너뛰고 신청 접수는 정상 동작합니다.
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=
